# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Auth (Google OAuth). The URL and anon/publishable key are safe for the
# browser. Configure Google as a provider in Supabase Auth and set redirect URLs there.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Server-side token verification uses the same public anon key; never put a
# service-role/secret key in VITE_* variables.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Server-only integrations. Do not prefix these with VITE_.
RAILRADAR_API_KEY=""
OPENWEATHER_API_KEY=""

# MapTiler styles are rendered by the browser; restrict this key to your domain.
VITE_MAPTILER_API_KEY=""

OPENTOPOGRAPHY_API_KEY=""

# Supabase Dashboard → Project Settings → Database → Connection string (URI).
# Use the pooler URI for hosted/serverless deployments when appropriate.
DATABASE_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
