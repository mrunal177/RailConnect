# RailConnect AI — Environment Configuration Example

# Server Environment Variables
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=railconnect_db
DB_PORT=3306

# Authentication & Security
JWT_SECRET=railconnect_secret_jwt_key_2026_super_secure

# Client Environment Variables (for Vite frontend)
VITE_API_BASE_URL=http://localhost:5000/api
